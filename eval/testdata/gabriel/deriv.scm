(import (scheme base) (scheme cxr) (scheme write) (scheme time))
(include "harness.scm")
(define (deriv-aux a) (list '/ (deriv a) a))
(define (deriv a)
  (cond
    ((not (pair? a))
     (cond ((eq? a 'x) 1) (else 0)))
    ((eq? (car a) '+)
     (cons '+ (map deriv (cdr a))))
    ((eq? (car a) '-)
     (cons '- (map deriv (cdr a))))
    ((eq? (car a) '*)
     (list '* a (cons '+ (map deriv-aux (cdr a)))))
    ((eq? (car a) '/)
     (list '-
           (list '/ (deriv (cadr a)) (caddr a))
           (list '/ (cadr a)
                 (list '* (caddr a) (caddr a) (deriv (caddr a))))))
    (else 'error)))
(bench "deriv" 20 (lambda ()
  (do ((i 0 (+ i 1))) ((= i 200) 'done)
    (deriv '(+ (* 3 x x) (* a x x) (* b x) 5)))))
